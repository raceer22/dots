output "Samsung Display Corp. 0x4158 Unknown" {
  mode 1920x1080@60
  scale 1.2
  alias $INTERNAL
}

output "Lenovo Group Limited LEN P27u-10 0x59333159" {
    mode 3840x2160@60
    scale 1.5
}

output "Dell Inc. DELL P2217H RH81R71J17EB" {
    mode 1920x1080@60
    scale 1.0
}

output DP-1 {
    mode 2560x1440@60
    scale 1
}

output "Lenovo Group Limited T24i-10 VT490816" {
    mode 1920x1080@60
    scale 1.0
}

output "Lenovo Group Limited LEN P27h-10 0x01010101" {
    mode 2560x1440@60
    scale 1
    alias $LENOVO
}

profile internal {
    output $INTERNAL enable
}

profile dock {
    output $INTERNAL {
        enable
        position 512,1440
    }
    output $LENOVO {
        enable
        position 0,0
    }
}

profile dock_2 {
    output $INTERNAL {
        enable
        position 512,1440
    }
    output DP-1 {
        enable
        position 0,0
    }
}

profile home {
    output "Lenovo Group Limited LEN P27u-10 0x59333159" {
        enable
        position 1080,0
    }
    output "Dell Inc. DELL P2217H RH81R71J17EB" {
        enable
        position 0,0
        transform 90
    }
    output "Lenovo Group Limited T24i-10 VT490816" {
        enable
        position 3640,135
    }
}

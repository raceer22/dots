layout {

    focus-ring {
        active-color   "#8ba9c1"
        inactive-color "#1a1f23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8ba9c1"
        inactive-color "#1a1f23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a1f2370"
    }

    tab-indicator {
        active-color   "#8ba9c1"
        inactive-color "#2f506a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8ba9c180"
    }
}

recent-windows {
    highlight {
        active-color "#8ba9c1"
        urgent-color "#fd4663"
    }
}

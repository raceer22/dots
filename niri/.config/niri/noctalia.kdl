layout {

    focus-ring {
        active-color   "#a2b08d"
        inactive-color "#1c1e1a"
        urgent-color   "#ce7a71"
    }

    border {
        active-color   "#a2b08d"
        inactive-color "#1c1e1a"
        urgent-color   "#ce7a71"
    }

    shadow {
        color "#0a0a0970"
    }

    tab-indicator {
        active-color   "#a2b08d"
        inactive-color "#495a30"
        urgent-color   "#ce7a71"
    }

    insert-hint {
        color "#a2b08d80"
    }
}

recent-windows {
    highlight {
        active-color "#a2b08d"
        urgent-color "#ce7a71"
    }
}

default partial alphanumeric_keys
xkb_symbols "basic" {

    include "us(basic)"
    name[Group1] = "Swedish (US with ö and ä swap)";

    // Explicitly make Right Alt act as Level 3 shift
    key <RALT> {
        type = "ONE_LEVEL",
        symbols[Group1] = [ ISO_Level3_Shift ]
    };
    modifier_map Mod5 { <RALT> };

    // Semicolon key (<AC10>): ö, Ö, ;, :
    key <AC10> {
        type = "FOUR_LEVEL",
        symbols[Group1] = [ odiaeresis, Odiaeresis, semicolon, colon ]
    };

    // Apostrophe key (<AC11>): ä, Ä, ', "
    key <AC11> {
        type = "FOUR_LEVEL",
        symbols[Group1] = [ adiaeresis, Adiaeresis, apostrophe, quotedbl ]
    };

    // Bracket key (<AD11>): [, {, å, Å
    key <AD11> {
        type = "FOUR_LEVEL",
        symbols[Group1] = [ bracketleft, braceleft, aring, Aring ]
    };
};

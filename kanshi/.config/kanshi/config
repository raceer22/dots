output "Samsung Display Corp. 0x4158 Unknown" {
  mode 1920x1080@60
  scale 1.2
  alias $INTERNAL
}

output "Lenovo Group Limited LEN P27h-10 0x01010101" {
    mode 2560x1440@60
    scale 1
    alias $LENOVO
}

output DP-1 {
    mode 2560x1440@60
    scale 1
    alias $DP
}

profile internal {
    output $INTERNAL enable
}

profile dock {
    output $INTERNAL {
        enable
        position 512,1440
    }
    output $LENOVO {
        enable
        position 0,0
    }
}

profile dock_2 {
    output $INTERNAL {
        enable
        position 512,1440
    }
    output $DP {
        enable
        position 0,0
    }
}
